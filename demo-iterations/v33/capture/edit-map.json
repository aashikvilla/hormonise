  "narrationCount": 19,
  "narration": [
    {
      "start": 0.2,
      "end": 6.6,
      "text": "I’m Arjun. I can’t tell my family what I want without feeling ungrateful.",
      "caption": "I’m Arjun. I can’t tell my family what I want without feeling ungrateful."
    },
    {
      "start": 8.15,
      "end": 12.15,
      "text": "Arjun puts the family pressure into his own words.",
      "caption": "Arjun puts the family pressure into his own words."
    },
    {
      "start": 12.25,
      "end": 16.6,
      "text": "No one else sees this reflection.",
      "caption": "No one else sees this reflection."
    },
    {
      "start": 17.1,
      "end": 20.55,
      "text": "Muse Spark's planned role is organizing themes.",
      "caption": "Muse Spark's planned role is organizing themes."
    },
    {
      "start": 20.6,
      "end": 24.0,
      "text": "Prepared example; no model is connected.",
      "caption": "Prepared example; no model is connected."
    },
    {
      "start": 24.15,
      "end": 28.15,
      "text": "A possible reading is offered for him to check.",
      "caption": "A possible reading is offered for him to check."
    },
    {
      "start": 28.2,
      "end": 31.2,
      "text": "He says, “Not quite.”",
      "caption": "He says, “Not quite.”"
    },
    {
      "start": 31.3,
      "end": 36.1,
      "text": "He needs time to decide for himself.",
      "caption": "He needs time to decide for himself."
    },
    {
      "start": 44.75,
      "end": 47.4,
      "text": "The reflection changes to hold his correction.",
      "caption": "The reflection changes to hold his correction."
    },
    {
      "start": 47.7,
      "end": 51.05,
      "text": "One prepared fictional perspective appears.",
      "caption": "One prepared fictional perspective appears."
    },
    {
      "start": 51.05,
      "end": 55.05,
      "text": "Ravi says a trusted friend helped him speak with family.",
      "caption": "Ravi says a trusted friend helped him speak with family."
    },
    {
      "start": 55.52,
      "end": 59.62,
      "text": "They share family pressure; their circumstances differ.",
      "caption": "They share family pressure; their circumstances differ."
    },
    {
      "start": 59.81,
      "end": 63.61,
      "text": "If he asks, it is for the group under an alias.",
      "caption": "If he asks, it is for the group under an alias."
    },
    {
      "start": 63.71,
      "end": 66.61,
      "text": "His private reflection is excluded.",
      "caption": "His private reflection is excluded."
    },
    {
      "start": 67.81,
      "end": 71.51,
      "text": "Consent remains unchecked.",
      "caption": "Consent remains unchecked."
    },
    {
      "start": 71.66,
      "end": 74.41,
      "text": "He cancels and keeps the draft.",
      "caption": "He cancels and keeps the draft."
    },
    {
      "start": 74.61,
      "end": 77.11,
      "text": "Nothing is sent.",
      "caption": "Nothing is sent."
    },
    {
      "start": 77.81,
      "end": 82.01,
      "text": "For now, his words stay private.",
      "caption": "For now, his words stay private."
    },
    {
      "start": 82.11,
      "end": 86.61,
      "text": "He can ask for time before deciding.",
      "caption": "He can ask for time before deciding."
    }

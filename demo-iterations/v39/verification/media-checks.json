  "captionCueAudit": [
    {
      "start": 0.0,
      "end": 4.0,
      "text": "I can\u2019t tell my family what I want without feeling ungrateful.",
      "exactV13": true
    },
    {
      "start": 6.0,
      "end": 10.8,
      "text": "Private reflection you can correct before exploring peer experiences.",
      "exactV13": true
    },
    {
      "start": 10.8,
      "end": 16.1,
      "text": "Planned Muse Spark may organize themes to review, never decide what is true.",
      "exactV13": true
    },
    {
      "start": 16.2,
      "end": 20.3,
      "text": "A local example offers a possibility, not an answer.",
      "exactV13": true
    },
    {
      "start": 20.4,
      "end": 22.8,
      "text": "Arjun says, Not quite.",
      "exactV13": true
    },
    {
      "start": 23.0,
      "end": 27.2,
      "text": "He changes the words: it is his parents, and he wants time.",
      "exactV13": true
    },
    {
      "start": 27.5,
      "end": 31.0,
      "text": "Now the editable reflection changes with what he said.",
      "exactV13": true
    },
    {
      "start": 31.2,
      "end": 35.4,
      "text": "He wants time to decide, without advice to stay or leave.",
      "exactV13": true
    },
    {
      "start": 38.0,
      "end": 41.425,
      "text": "Day four: one member wants time to choose.",
      "exactV13": true
    },
    {
      "start": 43.0,
      "end": 47.3,
      "text": "Day nine. The host says, I can listen; I can\u2019t decide for you.",
      "exactV13": true
    },
    {
      "start": 47.5,
      "end": 51.5,
      "text": "Fictional historical examples, prepared and not live.",
      "exactV13": true
    },
    {
      "start": 51.5,
      "end": 55.65,
      "text": "Arjun edits one question; the exact preview changes.",
      "exactV13": true
    },
    {
      "start": 55.7,
      "end": 58.89,
      "text": "The alias and group audience stay visible.",
      "exactV13": true
    },
    {
      "start": 58.9,
      "end": 62.56,
      "text": "Private conversation and context are excluded.",
      "exactV13": true
    },
    {
      "start": 62.6,
      "end": 66.6,
      "text": "Consent is unchecked. Continue stays disabled.",
      "exactV13": true
    },
    {
      "start": 66.7,
      "end": 69.4,
      "text": "Nothing is sent from this preview.",
      "exactV13": true
    },
    {
      "start": 69.7,
      "end": 72.81,
      "text": "No provider is verified or bookable here.",
      "exactV13": true
    },
    {
      "start": 73.5,
      "end": 76.39,
      "text": "He keeps time to decide privately.",
      "exactV13": true
    },
    {
      "start": 77.0,
      "end": 80.05,
      "text": "He could leave without sharing anything.",
      "exactV13": true
    },
    {
      "start": 81.0,
      "end": 84.11,
      "text": "Maybe later keeps that choice open.",
      "exactV13": true
    },
    {
      "start": 86.6,
      "end": 89.98,
      "text": "Nothing is sent without consent. Arjun can leave it here.",
      "exactV13": true
    }
